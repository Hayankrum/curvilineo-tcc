generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id                   Int              @id @default(autoincrement())
  nome                 String
  email                String           @unique
  senha                String
  bio                  String?
  fotoUrl              String?
  tipoUsuario          String           @default("discente")
  aceitouTermos        Boolean          @default(false)
  notificacoesAtivas   Boolean          @default(true)
  notificarSistema     Boolean          @default(true)
  notificarQuestionarios Boolean        @default(true)
  notificarCanais      Boolean          @default(true)
  inscricoesCanal      NotificacaoCanal[]
  isAdmin              Boolean          @default(false)
  criadoEm             DateTime         @default(now())
  sessoes              Sessao[]
  inscricoes           InscricaoPush[]
  notificacoes         Notificacao[]
  medias               Media[]
  questionarios        Questionario[]
  respostasQuestionario Resposta[]
  canais               Canal[]
  publicacoes          Publicacao[]
  votosEnquete         Voto[]
  reacoes              Reacao[]
}

model Sessao {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEm  DateTime
  criadoEm  DateTime @default(now())
}

model InscricaoPush {
  id           Int      @id @default(autoincrement())
  endpoint     String
  p256dh       String
  auth         String
  usuarioId    Int
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  criadoEm     DateTime @default(now())

  @@unique([endpoint])
}

model Notificacao {
  id         Int      @id @default(autoincrement())
  titulo     String
  mensagem   String
  url        String?
  lida       Boolean  @default(false)
  criadaEm   DateTime @default(now())
  enviadaEm  DateTime?
  usuarioId  Int
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Media {
  id          String   @id @default(cuid())
  ownerId     Int
  filename    String
  originalName String
  mimeType    String
  size        Int
  storageKey  String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       Usuario  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model Questionario {
  id           Int         @id @default(autoincrement())
  titulo       String
  descricao    String?
  status       String      @default("rascunho")
  anonimo      Boolean     @default(false)
  corTema      String?     @default("#6366f1")
  criadoEm     DateTime    @default(now())
  atualizadoEm DateTime    @updatedAt
  encerraEm    DateTime?
  usuariosEsperados Int?
  autorId      Int
  autor        Usuario     @relation(fields: [autorId], references: [id], onDelete: Cascade)
  perguntas    Pergunta[]
  respostas    Resposta[]

  @@index([autorId])
  @@index([status])
}

model Pergunta {
  id             Int           @id @default(autoincrement())
  texto          String
  tipo           String
  obrigatoria    Boolean       @default(false)
  ordem          Int
  configEscala   Json?
  condicoes      Json?
  questionarioId Int
  questionario   Questionario  @relation(fields: [questionarioId], references: [id], onDelete: Cascade)
  opcoes         Opcao[]
  valores        ValorResposta[]

  @@index([questionarioId])
}

model Opcao {
  id         Int             @id @default(autoincrement())
  texto      String
  ordem      Int
  correta    Boolean         @default(false)
  perguntaId Int
  pergunta   Pergunta        @relation(fields: [perguntaId], references: [id], onDelete: Cascade)
  valores    ValorResposta[]

  @@index([perguntaId])
}

model Resposta {
  id             Int            @id @default(autoincrement())
  usuarioId      Int
  usuario        Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  questionarioId Int
  questionario   Questionario   @relation(fields: [questionarioId], references: [id], onDelete: Cascade)
  nomeAnonimo    String?
  criadoEm       DateTime       @default(now())
  valores        ValorResposta[]

  @@unique([usuarioId, questionarioId])
  @@index([questionarioId])
}

model ValorResposta {
  id            Int      @id @default(autoincrement())
  respostaId    Int
  resposta      Resposta @relation(fields: [respostaId], references: [id], onDelete: Cascade)
  perguntaId    Int
  pergunta      Pergunta @relation(fields: [perguntaId], references: [id], onDelete: Cascade)
  texto         String?
  opcaoId       Int?
  opcao         Opcao?   @relation(fields: [opcaoId], references: [id])
  valorNumerico Int?

  @@index([respostaId])
  @@index([perguntaId])
}

model Canal {
  id           Int            @id @default(autoincrement())
  nome         String
  descricao    String?
  ativo        Boolean        @default(true)
  criadoEm     DateTime       @default(now())
  atualizadoEm DateTime       @updatedAt
  autorId      Int
  autor        Usuario        @relation(fields: [autorId], references: [id], onDelete: Cascade)
  publicacoes  Publicacao[]
  inscricoes   NotificacaoCanal[]

  @@index([autorId])
  @@index([ativo])
}

model Publicacao {
  id           Int            @id @default(autoincrement())
  tipo         String
  titulo       String?
  conteudo     String?
  criadoEm     DateTime       @default(now())
  atualizadoEm DateTime       @updatedAt
  canalId      Int
  canal        Canal          @relation(fields: [canalId], references: [id], onDelete: Cascade)
  autorId      Int
  autor        Usuario        @relation(fields: [autorId], references: [id], onDelete: Cascade)
  evento       Evento?
  enquete      Enquete?
  reacoes      Reacao[]

  @@index([canalId])
  @@index([autorId])
  @@index([tipo])
  @@index([criadoEm])
}

model Evento {
  id             Int      @id @default(autoincrement())
  publicacaoId   Int      @unique
  publicacao     Publicacao @relation(fields: [publicacaoId], references: [id], onDelete: Cascade)
  data           DateTime
  horaInicio     String
  horaFim        String?
  local          String?
  link           String?
}

model Enquete {
  id                   Int        @id @default(autoincrement())
  publicacaoId         Int        @unique
  publicacao           Publicacao @relation(fields: [publicacaoId], references: [id], onDelete: Cascade)
  permiteMultiplaEscolha Boolean @default(false)
  opcoes               OpcaoEnquete[]
  votos                Voto[]
}

model OpcaoEnquete {
  id         Int        @id @default(autoincrement())
  enqueteId  Int
  enquete    Enquete    @relation(fields: [enqueteId], references: [id], onDelete: Cascade)
  texto      String
  ordem      Int
  votos      Voto[]

  @@index([enqueteId])
}

model Voto {
  id          Int          @id @default(autoincrement())
  enqueteId   Int
  enquete     Enquete      @relation(fields: [enqueteId], references: [id], onDelete: Cascade)
  opcaoId     Int
  opcao       OpcaoEnquete @relation(fields: [opcaoId], references: [id], onDelete: Cascade)
  usuarioId   Int
  usuario     Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  criadoEm    DateTime     @default(now())

  @@unique([enqueteId, usuarioId])
  @@index([enqueteId])
  @@index([opcaoId])
  @@index([usuarioId])
}

model Reacao {
  id          Int        @id @default(autoincrement())
  publicacaoId Int
  publicacao  Publicacao @relation(fields: [publicacaoId], references: [id], onDelete: Cascade)
  usuarioId   Int
  usuario     Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo        String
  criadoEm    DateTime   @default(now())

  @@unique([publicacaoId, usuarioId])
  @@index([publicacaoId])
  @@index([usuarioId])
}

model NotificacaoCanal {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  canalId   Int
  canal     Canal    @relation(fields: [canalId], references: [id], onDelete: Cascade)
  criadoEm  DateTime @default(now())

  @@unique([usuarioId, canalId])
  @@index([usuarioId])
  @@index([canalId])
}